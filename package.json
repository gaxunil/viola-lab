{
  "name": "viola-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "bun server.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:render": "vitest run --project render",
    "inspect": "bun scripts/inspect.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "solid-js": "^1.9.15",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-solid": "^0.17.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
